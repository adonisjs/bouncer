{
  "name": "@adonisjs/bouncer",
  "version": "4.0.0",
  "description": "Authorization layer for AdonisJS",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "build/index.js",
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js",
    "./commands": "./build/commands/main.js",
    "./bouncer_provider": "./build/providers/bouncer_provider.js",
    "./plugins/edge": "./build/src/plugins/edge.js"
  },
  "scripts": {
    "pretest": "npm run lint",
    "test": "cross-env NODE_DEBUG=adonisjs:bouncer npm run quick:test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "clean": "del-cli build",
    "copy:templates": "copyfiles \"stubs/**/*.stub\" --up=\"1\" build",
    "precompile": "npm run lint && npm run clean",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "postcompile": "npm run copy:templates && npm run index:commands",
    "build": "npm run compile",
    "version": "npm run build",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "index:commands": "adonis-kit index build/commands",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.0",
    "@adonisjs/core": "^7.5.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/i18n": "^3.0.1",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/expect-type": "^2.0.4",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^5.3.0",
    "@japa/snapshot": "^2.0.10",
    "@poppinss/ts-exec": "^1.4.4",
    "@release-it/conventional-changelog": "^12.0.0",
    "c8": "^12.0.0",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "del-cli": "^7.0.0",
    "edge.js": "^6.5.1",
    "eslint": "^10.8.1",
    "reflect-metadata": "^0.2.2",
    "release-it": "^21.0.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@poppinss/utils": "^7.0.1"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0-next.26 || ^8.0.0",
    "@adonisjs/core": "^7.0.0-next.16 || ^7.0.0",
    "@adonisjs/i18n": "^3.0.0-next.2 || ^3.0.0",
    "edge.js": "^6.4.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    },
    "@adonisjs/i18n": {
      "optional": true
    },
    "edge.js": {
      "optional": true
    }
  },
  "homepage": "https://github.com/adonisjs/bouncer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adonisjs/bouncer.git"
  },
  "bugs": {
    "url": "https://github.com/adonisjs/bouncer/issues"
  },
  "keywords": [
    "authorization",
    "adonisjs"
  ],
  "author": "Harminder Virk <virk@adonisjs.com>",
  "contributors": [
    "Julien Ripouteau <julien@ripouteau.com>"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsdown": {
    "entry": [
      "./index.ts",
      "./src/types.ts",
      "./providers/bouncer_provider.ts",
      "./commands/make_policy.ts",
      "./src/plugins/edge.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
